{
  "name": "accountability-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Track what politicians say vs what they do",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "next-sitemap",
    "prebuild": "npm run icons:generate",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "icons:generate": "node scripts/generate-pwa-icons.js && node scripts/convert-icons-to-png.js && node scripts/generate-screenshots.js",
    "pipeline": "tsx pipeline/index.ts",
    "pipeline:members": "tsx pipeline/sources/congress-members.ts",
    "pipeline:votes": "tsx pipeline/sources/propublica-votes.ts",
    "db:push": "turso db shell accountability-dashboard < database/schema.sql",
    "db:studio": "turso db shell accountability-dashboard"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.75.0",
    "@libsql/client": "^0.17.0",
    "@types/xml2js": "^0.4.14",
    "next": "16.1.6",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "swr": "^2.2.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.11.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.17",
    "cheerio": "^1.2.0",
    "csv-parse": "^6.1.0",
    "jsdom": "^28.1.0",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.4.33",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
